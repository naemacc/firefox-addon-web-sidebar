{
  "manifest_version": 2,
  "author": "Naem",
  "name": "Web Sidebar",
  "version": "1.8.2",
  "description": "A mini browser in your sidebar. Open any website as a named tab, with an address bar, search, back/forward and history. No data collection.",
  "browser_specific_settings": {
    "gecko": {
      "id": "{5d1f0c52-8a3e-4b7a-9e61-2c4a7b0d93f8}",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "sidebar_action": {
    "default_title": "Web Sidebar",
    "default_panel": "sidebar.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "open_at_install": true
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      },
      "description": "Toggle the Web Sidebar"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "optional_permissions": ["browsingData"],
  "permissions": [
    "storage",
    "webRequest",
    "webRequestBlocking",
    "http://*/*",
    "https://*/*"
  ]
}
